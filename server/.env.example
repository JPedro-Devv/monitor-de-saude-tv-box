# Banco de dados (SQLite por padrão para o MVP)
DATABASE_URL=sqlite:///./monitor.db

# Offline/alertas
# OFFLINE_TIMEOUT_HOURS: tempo sem contato para considerar offline (ex.: 5; para teste rápido use 0.05 = ~3 min)
# OFFLINE_CHECK_INTERVAL_MINUTES: frequência da verificação (mínimo efetivo 1 min)
OFFLINE_TIMEOUT_HOURS=5
OFFLINE_CHECK_INTERVAL_MINUTES=5

# Telegram (alertas)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=false
