# Identidade do dispositivo (deve existir no servidor)
DEVICE_ID=tvbox-001
DEVICE_TOKEN=troque-este-token

# URL do servidor (API)
SERVER_URL=http://10.0.0.10:8000
INGEST_PATH=/api/v1/ingest

# Intervalo de coleta/envio em segundos (5 min = 300)
INTERVAL_SECONDS=300

# Timeout de rede para envio (segundos)
HTTP_TIMEOUT_SECONDS=15

# Apps/serviços a monitorar (separados por vírgula: chave=nome_pacote_ou_processo)
# Exemplo: critico=com.app.anuncios,player=com.outro.player
WATCHED_APPS=critico=com.app.anuncios

# Execução de comandos perigosos (reboot). Use false para testar sem reiniciar.
ALLOW_REBOOT=false
# Se true, apenas simula o reboot (log), mesmo com ALLOW_REBOOT=true
REBOOT_DRY_RUN=true
